# ---- LLM（必填其一）----
# anthropic 协议（默认）：MiniMax-M3 走 MCode 网关
TRIP_LLM_PROVIDER=anthropic
TRIP_LLM_BASE_URL=https://agent.minimax.cn/mavis/api/v1/llm/v1
TRIP_LLM_MODEL=MiniMax-M3
# 若不设 TRIP_LLM_API_KEY，启动时自动从本机 MCode 登录态读取（仅本机开发方便）
# TRIP_LLM_API_KEY=

# OpenAI 兼容协议示例（OpenRouter / 自建网关 / vLLM）
# TRIP_LLM_PROVIDER=openai
# TRIP_LLM_BASE_URL=https://openrouter.ai/api/v1
# TRIP_LLM_MODEL=minimax/minimax-m3
# TRIP_LLM_API_KEY=sk-...

# ---- 数据源（全部可选，缺失则对应能力降级）----
# 高德 Web 服务 Key：开启后 POI 检索/营业时间/票价/评分/路线显著增强
# AMAP_KEY=
# Bing/Serp/Tavily 等网页检索 Key（可选，用于补充时效信息）
# TRIP_WEB_SEARCH_KEY=

# ---- 服务 ----
TRIP_PORT=8787
TRIP_DATA_DIR=./data
